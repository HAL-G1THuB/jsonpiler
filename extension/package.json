{
  "publisher": "H4LVS",
  "name": "jsplsyntax",
  "displayName": "Jsonpiler",
  "description": "Provides language server and language features for JSPL.",
  "version": "0.3.0",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "icon": "images/icon.png",
  "main": "dist/extension.js",
  "activationEvents": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/HAL-G1THuB/jsonpiler.git"
  },
  "contributes": {
    "commands": [
      {
        "command": "jspl.run",
        "title": "Run JSPL"
      }
    ],
    "configuration": {
      "title": "JSPL Settings",
      "properties": {
        "jspl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the language server."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "jspl.run",
          "when": "editorLangId == jspl",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "jspl",
        "aliases": [
          "JSPL",
          "jspl"
        ],
        "icon": {
          "light": "./images/icon.png",
          "dark": "./images/icon.png"
        },
        "extensions": [
          ".jspl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jspl",
        "scopeName": "source.jspl",
        "path": "./syntaxes/jspl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "jspl",
        "path": "./snippets/jspl.code-snippets"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/vscode": "^1.103.0"
  }
}
